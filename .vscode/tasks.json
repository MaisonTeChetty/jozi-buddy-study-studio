{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Jozi Buddy",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-u", "${workspaceFolder}/voice_agent.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": []
        }
    ]
}
